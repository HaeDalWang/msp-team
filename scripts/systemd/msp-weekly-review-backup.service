[Unit]
Description=MSP weekly review PostgreSQL backup to S3
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/msp-weekly-review
EnvironmentFile=/etc/msp-weekly-review-backup.env
ExecStart=/usr/bin/bash /opt/msp-weekly-review/scripts/backup.sh
UMask=0077
