POSTGRES_PASSWORD=change-this-before-first-start
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
NODE_ENV=development
# Slack 없이 로컬 개발할 때만 seed.json에 있는 사용자 id를 명시합니다.
LOCAL_DEV_USER_ID=
# HTTPS 운영 overlay 사용 시 DNS가 서버를 가리키는 도메인
APP_DOMAIN=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups

# Slack OAuth (Sign in with Slack). 로컬 테스트는 http://localhost:3000/auth/slack/callback을
# Slack App의 Redirect URLs에 등록한 뒤 아래 SLACK_REDIRECT_URI를 그대로 두면 됩니다.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/auth/slack/callback
# openssl rand -hex 32 로 생성. 운영에서는 32자 이상 값이 없으면 기동을 거부합니다.
SESSION_SECRET=change-this-before-first-start
# 운영에서는 팀 Slack workspace(team_id)를 반드시 지정합니다.
ALLOWED_SLACK_TEAM_ID=
# users.profile:read 봇 권한이 있는 xoxb 토큰. Slack 연락처와 Start Date를 빈 프로필의 기본값으로 사용합니다.
SLACK_PROFILE_TOKEN=
