POSTGRES_PASSWORD=change-this-before-first-start
APP_PORT=3000

# Slack OAuth (Sign in with Slack). 로컬 테스트는 http://localhost:3000/auth/slack/callback을
# Slack App의 Redirect URLs에 등록한 뒤 아래 SLACK_REDIRECT_URI를 그대로 두면 됩니다.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/auth/slack/callback
# openssl rand -hex 32 로 생성. 비어 있으면 세션 서명이 무력화되므로 반드시 채워야 합니다.
SESSION_SECRET=change-this-before-first-start
# 특정 Slack workspace(team_id)만 허용하려면 지정. 비워두면 team 제한 없이 등록된 사용자만 허용.
ALLOWED_SLACK_TEAM_ID=
