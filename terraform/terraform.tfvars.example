# 이 파일을 terraform.tfvars로 복사한 뒤 실제 값으로 채운다.
# cp terraform.tfvars.example terraform.tfvars

# 이 저장소를 복제해서 배포할 때 반드시 바꿔야 하는 값들
repo_url = "https://github.com/HaeDalWang/msp-team.git"
repo_ref = "main"

# 계정/리전이 다르면 여기만 바꾼다 (같은 계정에 여러 환경을 두려면 project_name도 바꿀 것)
aws_region   = "ap-northeast-2"
project_name = "msp-weekly-review"

# 선택
instance_type = "t3.medium"
ssh_key_name  = ""

# 주의: Slack Client ID/Secret, PostgreSQL 비밀번호, SESSION_SECRET은 여기 넣지 않는다.
# terraform apply로 인프라만 만든 뒤, app_public_ip 출력값을 확인하고
# scripts/deploy-app.sh를 SSM으로 실행할 때 환경변수로 넘긴다 (2단계 배포).
